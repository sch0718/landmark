{
  "name": "landmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "yarn build:viewer && vite",
    "dev:full": "yarn build:viewer && wrangler pages dev --proxy 5173 -- vite --port 5173 --strictPort",
    "build": "yarn build:viewer && tsc -b && vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "build:hero": "node --disable-warning=ExperimentalWarning scripts/build-readme-hero.mjs",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build:map": "vite build --config vite.map.config.ts",
    "build:map:e2e": "VITE_MAP_ADAPTER=fake vite build --config vite.map.config.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "yarn build:map:e2e && playwright test",
    "test:e2e:ci": "yarn build:map:e2e && playwright test --grep @smoke",
    "lint": "eslint .",
    "fm:check": "prettier --check .",
    "collect": "tsx pipeline/cli/collect.ts",
    "apply-edit": "tsx pipeline/cli/apply-edit.ts",
    "validate": "tsx pipeline/cli/validate.ts",
    "effect:source": "node scripts/effect-source.mjs",
    "orphans": "node scripts/find-orphans.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "build:ci": "yarn validate && yarn typecheck && yarn test && yarn build && yarn size --require-lazy MeetingsPage --require-lazy MeetingEditorPage --require-lazy MeetLinkPage --require-lazy TripsPage --require-lazy TripPlannerPage --require-lazy SettingsPage --require-lazy LabelsPage --require-lazy LegacyImportPage --require-lazy LinkInputPanel --require-lazy CandidateCard --require-lazy FolderPreview --require-lazy PinCard --require-lazy SharePickPanel --require-lazy SharePreview --require-lazy ExportHtmlDialog --require-lazy RestoreDialog --require-lazy TripTodayPage --require-lazy TripShareDialog --require-lazy LabelPickerDialog --require-lazy LabelFilterDialog --require-lazy ChipScrollButton --require-lazy TripPickerDialog --require-lazy TripFormDialog --require-lazy label-create && yarn build:map",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": "prettier --write"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/gowun-batang": "^5.3.0",
    "@mui/material": "^7",
    "@mui/utils": "^7.3.11",
    "@tanstack/react-virtual": "3.14.13",
    "dayjs": "^1.11.23",
    "effect": "4.0.2",
    "es-toolkit": "^1.52.0",
    "jotai": "^3.0.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7",
    "sonner": "^2.0.8",
    "supercluster": "^9.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@effect/vitest": "4.0.2",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.141",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "4.142.0"
  }
}
