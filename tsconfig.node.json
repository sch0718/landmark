{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/node-out"
  },
  "include": [
    "vite.config.ts",
    "vite.viewer.config.ts",
    "vite.map.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "build/compile-react-svg-icon.ts",
    "build/inline-assets.ts"
  ]
}
